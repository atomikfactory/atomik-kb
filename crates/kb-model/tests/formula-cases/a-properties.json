  },
  {
   "id": "sumhours",
   "name": "Sum hours",
   "kind": "formula",
   "expression": "prop(\"Tasks\").map(current.prop(\"Hours\")).sum()"
  },
  {
   "id": "flag",
   "name": "Flag",
   "kind": "formula",
   "expression": "prop(\"Price\") > 2"
  },
  {
   "id": "when",
   "name": "When",
   "kind": "formula",
   "expression": "dateAdd(prop(\"Due\"), 1, \"days\")"
  },
  {
   "id": "loopa",
   "name": "Loop A",
   "kind": "formula",
   "expression": "prop(\"Loop B\")"
  },
  {
   "id": "loopb",
   "name": "Loop B",
   "kind": "formula",
   "expression": "prop(\"Loop A\")"
  },
  {
   "id": "broken",
   "name": "Broken",
   "kind": "formula",
   "expression": "1 +"
  },
  {
   "id": "usesbroken",
   "name": "Uses broken",
   "kind": "formula",
   "expression": "prop(\"Broken\") + 1"
  },
  {
   "id": "usescreator",
   "name": "Uses creator",
   "kind": "formula",
   "expression": "prop(\"Creator\")"
  },
  {
   "id": "selfpeek",
   "name": "Self peek",
   "kind": "formula",
   "expression": "prop(\"Tasks\").map(current.prop(\"Self peek\")).sum()"
  }
