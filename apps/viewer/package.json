{
  "name": "@atomik-kb/viewer",
  "version": "0.1.0",
  "private": true,
  "description": "The web viewer of view-only links (M13 slice 4, ADR-0051): shows one page, read-only, from a publication it opens in the browser with kb-wasm. Served by kb-server at /view.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-wasm.mjs --if-missing && vite",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "node scripts/build-wasm.mjs && tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "lint": "node scripts/build-wasm.mjs --if-missing && eslint .",
    "typecheck": "node scripts/build-wasm.mjs --if-missing && tsc --noEmit",
    "test": "node scripts/build-wasm.mjs --if-missing && vitest run"
  },
  "dependencies": {
    "@atomik-kb/core-client": "workspace:*",
    "@atomik-kb/ui": "workspace:*",
    "loro-crdt": "1.16.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.3",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "5.0.5"
  }
}
