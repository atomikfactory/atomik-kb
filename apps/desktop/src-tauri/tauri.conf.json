{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "atomik-kb",
  "identifier": "com.atomik-kb.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "atomik-kb",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob: http://kbmedia.localhost kbmedia:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob: http://kbmedia.localhost kbmedia:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["atomik-kb"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "atomik-kb contributors",
    "copyright": "Copyright (c) 2026 atomik-kb contributors",
    "license": "GPL-3.0-or-later",
    "category": "Productivity",
    "shortDescription": "Private, local-first knowledge base",
    "longDescription": "atomik-kb is a privacy-first, local-first notes and knowledge-base app. Your pages are stored encrypted on this device and the optional sync server never sees plaintext.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
