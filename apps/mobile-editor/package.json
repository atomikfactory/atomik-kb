{
  "name": "@atomik-kb/mobile-editor",
  "version": "0.1.0",
  "private": true,
  "description": "The page editor of the Android app (apps/android): the shared Tiptap/Loro editor in a WebView, talking to the app through window.kbHost (apps/android/ARCHITECTURE.md, Contract 2).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "sync:android": "node scripts/sync-android.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@atomik-kb/core-client": "workspace:*",
    "@atomik-kb/ui": "workspace:*",
    "@tiptap/core": "3.33.0",
    "loro-crdt": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "5.1.0"
  }
}
