{
  "name": "@atomik-kb/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared React UI for atomik-kb (desktop and web shells). Talks to the core only through @atomik-kb/core-client.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "fixtures": "vitest run --config vitest.fixtures.config.ts"
  },
  "dependencies": {
    "@atomik-kb/core-client": "workspace:*",
    "@excalidraw/excalidraw": "0.18.1",
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block-lowlight": "3.32.0",
    "@tiptap/extension-details": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-mention": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/extension-unique-id": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "katex": "0.19.1",
    "lib0": "^0.2.119",
    "loro-crdt": "1.17.1",
    "lowlight": "^3.3.0",
    "lucide-react": "1.61.0",
    "mermaid": "12.2.0",
    "pdfjs-dist": "6.4.299",
    "unicode-emoji-json": "0.9.0",
    "zustand": "^5.0.16"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
